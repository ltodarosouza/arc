# Copy this file to .env.local for local-only values. Never commit .env.local.
# Replace placeholders to enable accounts. Keep secrets in the hosting environment.

# Identifies the running environment for future diagnostics and configuration.
ARC_APP_ENV=development

# Canonical application origin used only by server-side or build-time features.
ARC_SITE_ORIGIN=http://localhost:3000

# Public, non-sensitive display configuration. NEXT_PUBLIC_ values are exposed to the browser.
NEXT_PUBLIC_ARC_APP_NAME=Arc
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public Supabase browser credentials. These values identify the project but
# are not secrets; database access is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_public_key

# Server only. Required for verified account deletion; never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
